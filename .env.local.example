# Скопируй в .env.local (локально) и в Vercel → Settings → Environment Variables (прод)

# Домен сайта — canonical/OG/sitemap. Без него в проде остаётся localhost!
NEXT_PUBLIC_SITE_URL=https://ваш-домен.ру

# Лид-форма → Telegram:
# 1) @BotFather → /newbot → токен сюда
# 2) добавь бота в чат/группу студии (или напиши ему в личку)
# 3) https://api.telegram.org/bot<ТОКЕН>/getUpdates → chat.id сюда
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Если группа с темами (форум): id темы для заявок — из message_thread_id
# любого сообщения в теме через getUpdates. Не задан — бот пишет в General.
TELEGRAM_THREAD_ID=

# Яндекс.Метрика: создай счётчик на metrika.yandex.ru, номер сюда.
# Цели создать в интерфейсе Метрики (тип «JavaScript-событие»):
#   tg_click  — клик по любой ссылке на Telegram
#   lead_sent — успешная отправка лид-формы
NEXT_PUBLIC_YM_ID=
